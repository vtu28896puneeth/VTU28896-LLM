import os
from google.colab import userdata
from google import genai

# Load API key from Colab Secrets
api_key = userdata.get("GEMINI_API_KEY")

# Create Gemini client using that key
client = genai.Client(api_key=api_key)

print("Gemini client initialized successfully.")
def retrieve_chunks(query, top_k=2):
    query_embedding = embedding_model.encode([query])

    distances, indices = index.search(
        np.array(query_embedding).astype("float32"),
        top_k
    )

    retrieved_chunks = [chunks[i] for i in indices[0]]

    return retrieved_chunks


query = "What are my technical skills?"

retrieved_chunks = retrieve_chunks(query)

print("User Question:")
print(query)

print("\nRetrieved Information:")

for i, chunk in enumerate(retrieved_chunks):
    print(f"\n--- Retrieved Chunk {i + 1} ---")
    print(chunk)
def chat(user_message):

    # Retrieve relevant information from RAG
    retrieved_chunks = retrieve_chunks(user_message)

    # Combine retrieved chunks
    context = "\n\n".join(retrieved_chunks)

    # Send both RAG context and the question to Gemini
    prompt = f"""
You are a helpful AI assistant.

You have access to:
1. Your general knowledge as an LLM.
2. Additional information retrieved from a knowledge base.

Use the knowledge base when it contains relevant information.
For general questions, use your own knowledge.
You can combine both when necessary.

Knowledge Base:
{context}

User Question:
{user_message}

Give a clear and accurate answer.
"""

    # Gemini LLM generates the final answer
    response = client.models.generate_content(
        model="gemini-3.5-flash-lite",
        contents=prompt
    )

    return response.text
